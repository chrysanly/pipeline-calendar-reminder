rules_version = '2';

// Each signed-in user can read and write only their own reminders, stored at
// users/{uid}/events/{eventId}. Everything else is denied (no other match).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
