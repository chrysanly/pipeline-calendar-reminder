# Firebase web app config for CladFlo. Copy this file to .env (never commit
# .env) and fill in the values from the Firebase console:
#   Project settings (gear icon) → General → Your apps → Web app →
#   SDK setup and configuration → Config
# Leave everything blank to run in local mode (no sign-in, data in this browser).
# Real environment variables with the same names override this file.

# apiKey
FIREBASE_API_KEY=
# authDomain
FIREBASE_AUTH_DOMAIN=
# projectId
FIREBASE_PROJECT_ID=
# storageBucket
FIREBASE_STORAGE_BUCKET=
# messagingSenderId
FIREBASE_MESSAGING_SENDER_ID=
# appId
FIREBASE_APP_ID=

# Optional features (public values, also blank-safe):
# The Cloudflare Worker that runs AI and email, e.g. https://pipeline.<you>.workers.dev
# (Settings → Business can override it per account).
WORKER_URL=
# Google Calendar sync: OAuth 2.0 Client ID (Web application) from
# Google Cloud console → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=
